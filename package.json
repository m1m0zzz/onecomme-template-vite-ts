{
  "name": "mu-mu-bokujo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "export": "tsc && vite build --mode export && tsx scripts/export.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt ."
  },
  "devDependencies": {
    "@onecomme.com/onesdk": "9.0.0-alpha.3",
    "@types/archiver": "7.0.0",
    "@types/node": "26.6.10",
    "archiver": "7.0.1",
    "oxfmt": "0.47.0",
    "oxlint": "1.95.0",
    "terser": "5.51.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.0"
  },
  "allowScripts": {
    "@onecomme.com/onesdk": false,
    "esbuild": false,
    "fsevents": false
  }
}
